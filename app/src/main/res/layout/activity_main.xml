<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">
<!-- The outer frame applies insets so the ScrollView has a smaller, scrollable IME-safe viewport. -->
<ScrollView
    tools:ignore="UselessParent"
    android:id="@+id/weather_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/app_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/app_name"
            android:textColor="@color/weather_ink"
            android:textSize="32sp" />

        <LinearLayout
            android:id="@+id/current_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/city_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/weather_ink"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/weather_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/weather_muted"
                android:textSize="18sp" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="132dp">
                <TextView
                    android:id="@+id/temperature_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="132dp"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/condition_illustration"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="0"
                    android:fontFamily="sans-serif-light"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="@color/weather_ink"
                    android:textSize="108sp"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="40sp"
                    app:autoSizeMaxTextSize="108sp"
                    app:autoSizeStepGranularity="1sp" />
                <ImageView
                    android:id="@+id/condition_illustration"
                    android:layout_width="155dp"
                    android:layout_height="115dp"
                    app:layout_constraintStart_toEndOf="@id/temperature_text_view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@drawable/weather_condition_partly_cloudy"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/state_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="64dp"
            android:paddingBottom="70dp">
            <ImageView
                android:id="@+id/state_illustration"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/weather_empty"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/weather_empty_title"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/weather_ink" />
            <TextView
                android:id="@+id/error_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/weather_empty_body"
                android:textSize="18sp"
                android:textColor="@color/weather_ink"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">
            <LinearLayout
                android:id="@+id/wind_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/weather_wind_background"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/weather_wind"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_wind_label"
                        android:textSize="14sp"
                        android:textColor="@color/weather_muted" />
                    <TextView
                        android:id="@+id/wind_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="22sp"
                        android:textColor="@color/weather_ink" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="12dp"
                android:text="@string/weather_retry"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="24dp" />

            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/weather_search_background"
                app:iconifiedByDefault="false"
                app:queryHint="@string/weather_search_hint"
                app:queryBackground="@android:color/transparent"
                app:submitBackground="@android:color/transparent"
                app:searchIcon="@drawable/weather_search"
                app:searchHintIcon="@null"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/location_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/weather_use_location"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="@color/weather_ink" />
            <TextView
                android:id="@+id/weather_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/weather_units"
                android:textSize="12sp"
                android:textColor="@color/weather_muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</FrameLayout>
